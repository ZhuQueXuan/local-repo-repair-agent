# Copy model settings into the project-root .env; never commit real credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash

# Optional primary gateway; leave its API key empty to use the official provider.
BUPT_API_KEY=
BUPT_API_BASE_URL=https://myai.bupt.edu.cn/llm-gw/v1
BUPT_CHAT_MODEL=deepseek-v4-flash
