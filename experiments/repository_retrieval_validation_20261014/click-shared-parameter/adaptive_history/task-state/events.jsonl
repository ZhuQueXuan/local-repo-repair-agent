{"kind": "executed", "sequence": 35, "command": "set -o pipefail\ncd \"$(pwd)\" && mkdir -p temp && cat > temp/repro.py <<'EOF'\nimport click\nfrom click.testing import CliRunner\n\nclass MyType(click.ParamType):\n    name = \"mytype\"\n    def convert(self, value, param, ctx):\n        return \"custom:\" + value\n\nshared_arg = click.argument(\"x\", cls=click.Argument, type=MyType())\nshared_opt = click.option(\"--y\", cls=click.Option, type=MyType())\n\n@click.command()\n@shared_arg\ndef cmd1(x):\n    click.echo(x)\n\n@click.command()\n@shared_arg\ndef cmd2(x):\n    click.echo(x)\n\nr = CliRunner()\nprint(\"cmd1:\", r.invoke(cmd1, [\"a\"]).output.strip())\nprint(\"cmd2:\", r.invoke(cmd2, [\"a\"]).output.strip())\nEOF\nPYTHONPATH=src python -B temp/repro.py", "returncode": 0, "exception_info": "", "output_path": "temp/tool-output/0035.txt", "output_sha256": "3dee5851c80b3874f0aa04a1a8158b78f5a1a4f6318f93edb9a92b4f151642f1", "revision": "c623f77d1639c2dbe3095b84ead47311c258d2317cbfef3df018a3ba5be500a7", "changed_files_this_action": []}
{"kind": "executed", "sequence": 36, "command": "set -o pipefail\ncd \"$(pwd)\" && cat > temp/repro.py <<'EOF'\nimport click\nfrom click.testing import CliRunner\n\nclass MyType(click.ParamType):\n    name = \"mytype\"\n    def convert(self, value, param, ctx):\n        return \"custom:\" + value\n\nclass MyArg(click.Argument):\n    pass\n\nclass MyOpt(click.Option):\n    pass\n\nshared_arg = click.argument(\"x\", cls=MyArg, type=MyType())\nshared_opt = click.option(\"--y\", cls=MyOpt, type=MyType())\n\n@click.command()\n@shared_arg\ndef cmd1(x):\n    click.echo(x)\n\n@click.command()\n@shared_arg\ndef cmd2(x):\n    click.echo(x)\n\n@click.command()\n@shared_opt\ndef cmd3(y):\n    click.echo(y)\n\n@click.command()\n@shared_opt\ndef cmd4(y):\n    click.echo(y)\n\nr = CliRunner()\nprint(\"cmd1:\", r.invoke(cmd1, [\"a\"]).output.strip())\nprint(\"cmd2:\", r.invoke(cmd2, [\"a\"]).output.strip())\nprint(\"cmd3:\", r.invoke(cmd3, [\"--y\", \"a\"]).output.strip())\nprint(\"cmd4:\", r.invoke(cmd4, [\"--y\", \"a\"]).output.strip())\nprint(\"cmd1 param type:\", type(cmd1.params[0]).__name__)\nprint(\"cmd2 param type:\", type(cmd2.params[0]).__name__)\nEOF\nPYTHONPATH=src python -B temp/repro.py", "returncode": 0, "exception_info": "", "output_path": "temp/tool-output/0036.txt", "output_sha256": "eaa42abce8b67d03ec05f569842fcc985948fc2800c20c3e962baecd1866b1c8", "revision": "c623f77d1639c2dbe3095b84ead47311c258d2317cbfef3df018a3ba5be500a7", "changed_files_this_action": []}
